#include <winver.h>
#include "../build/version.h"

// The helper's icon (the app's), its manifest (administrator rights) and the PawnIO CPU temperature modules.
1 ICON "../res/app.ico"
1 24 "cputemp.manifest"
200 RCDATA "../res/pawnio/IntelMSR.bin"
201 RCDATA "../res/pawnio/AMDFamily17.bin"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WB_VERSION_RESOURCE
PRODUCTVERSION WB_VERSION_RESOURCE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "symNistaken"
      VALUE "FileDescription", "Taskbar Vitals CPU temperature helper"
      VALUE "InternalName", "TaskbarVitalsTemp"
      VALUE "LegalCopyright", "Copyright (C) 2026 symNistaken & contributors (GPL-3.0-or-later)"
      VALUE "ProductName", "Taskbar Vitals"
      VALUE "FileVersion", WB_VERSION_STRING
      VALUE "ProductVersion", WB_VERSION_STRING
      VALUE "OriginalFilename", "TaskbarVitalsTemp.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
